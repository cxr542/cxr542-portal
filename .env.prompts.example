# Server only. For local Vite, export these in your shell; no VITE_ prefix.
PROMPTS_ENABLED=false
PROMPTS_SUPABASE_URL=https://YOUR_HOME_PROJECT.supabase.co
PROMPTS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# public by default. prompt_preview is allowed only in Vercel Preview or explicit local tests.
PROMPTS_DB_SCHEMA=public
# Never use a service-role/secret key here.
# Keep disabled until the native OAuth/ChatGPT PKCE pilot passes.
PROMPTS_OAUTH_ENABLED=false
PROMPTS_PUBLIC_ORIGIN=https://cxr542-portal.vercel.app
PROMPTS_OAUTH_CLIENT_ID=
PROMPTS_OAUTH_REDIRECT_URIS=

# MCP stays disabled until a dedicated client and signed resource claim are verified.
PROMPTS_MCP_ENABLED=false
